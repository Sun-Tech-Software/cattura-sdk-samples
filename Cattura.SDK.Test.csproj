<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<!-- Same namespace as the original project: XAML and code-behind compile without changes -->
		<RootNamespace>Cattura.SDK.Test</RootNamespace>
		<AssemblyName>Cattura.SDK.Test</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Different display name to distinguish it on the device -->
		<ApplicationTitle>Cattura SDK Test</ApplicationTitle>

		<!-- Different App ID: allows installing both versions on the same device -->
		<ApplicationId>it.suntech.cattura.sdk.test</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>

		<!-- Same build settings as the original project -->
		<AndroidStoreUncompressedFileExtensions>.tar;.tar.crypt</AndroidStoreUncompressedFileExtensions>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidEnableR8>false</AndroidEnableR8>
		<RunAOTCompilation>false</RunAOTCompilation>
		<PublishTrimmed>false</PublishTrimmed>
		<AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>

		<!-- Android manifest path -->
		<AndroidManifest>\Platforms\Android\AndroidManifest.xml</AndroidManifest>

	</PropertyGroup>

	<!-- ================================================================
	     Uses the Suntech.Cattura.SDK NuGet package instead of direct AAR references.
	     Same application logic, same XAML, same UI as the original project.
	     ================================================================ -->

	<!-- MAUI resources (icon, splash, fonts, images) -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#007830" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#007830" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiImage Include="Resources\Images\*" />
	</ItemGroup>

	<!-- MAUI-specific dependencies (not covered by the Suntech NuGet package) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.51" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Suntech.Cattura.SDK" Version="1.0.12" />
	</ItemGroup>
	<ItemGroup>
	  <MauiXaml Update="App.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="AppShell.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="MainPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Resources\Images\" />
	</ItemGroup>

</Project>
